{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "env": ["CI", "KINNSO_TEST_TARGET", "KINNSO_TEST_PROJECT", "KINNSO_APPROVED_SUPABASE_ORIGIN", "SUPABASE_DB_CONTAINER"]
    }
  }
}
