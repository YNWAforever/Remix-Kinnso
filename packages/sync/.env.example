# Legacy MySQL (read-only)
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=kinnso
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# TLS to legacy MySQL. One of: require (default) | verify-ca | disable.
#   require   = encrypt, do not verify the server certificate. Blocks passive
#               sniffing of the credentials and article content above; an active
#               MITM is still possible.
#   verify-ca = encrypt AND verify the server cert against LEGACY_DB_SSL_CA below.
#               Use this in production whenever the provider publishes a CA bundle.
#   disable   = plaintext, no TLS at all.
# NOTE: this defaults to `require`, so a legacy MySQL server with NO TLS support will
# fail to connect until the operator explicitly sets LEGACY_DB_SSL=disable. That opt-out
# is deliberate — credentials must never fall back to cleartext silently.
#
# Don't guess which mode this server needs. Fill in the values above and run:
#
#   pnpm --filter @kinnso/sync preflight
#
# It connects with the configured mode and, if TLS is what failed, retries once with
# TLS off purely to tell "this server has no TLS" apart from "this server is
# unreachable". It only reports — it never changes configuration. Exit 0 means the
# mode set here works. The same explanation is attached to connection failures at
# runtime, so a wrong setting names itself in the logs rather than surfacing as a
# bare driver error.
LEGACY_DB_SSL=require
# PEM contents of the CA that signed the legacy MySQL server cert. Required (and only
# read) when LEGACY_DB_SSL=verify-ca.
LEGACY_DB_SSL_CA=
# Timezone the legacy MySQL DATETIME columns (published_at, end_at, edit_at, deleted_at,
# validated_at) were written in. They carry no zone, so this is what turns them into
# instants. Accepts 'UTC' (default) or a fixed offset such as '+08:00'; named IANA zones
# are rejected because no DST rules are applied. Setting this wrong shifts every
# publication time, so confirm the legacy app's timezone before changing it.
LEGACY_DB_TIMEZONE=UTC
# Supabase (service_role bypasses RLS — secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# CDN base used to rewrite {{image_path}} and bare filenames
CDN_BASE_URL=https://cdn.kinnso.ai
