# apps/scan — copy to .env (local dev) or .env.test (integration tests)

# Server
PORT=8788

# CORS — the exact origin of the web app allowed to call this worker
# (must match NEXT_PUBLIC_SCAN_URL's counterpart on the web side).
# REQUIRED when NODE_ENV=production: loadConfig() throws "Missing env WEB_ORIGIN"
# rather than silently falling back. Outside production it defaults to '*' so
# local dev and CI need no extra setup; the worker logs a warning when it does.
WEB_ORIGIN=http://localhost:3000

# Supabase — both keys required
SUPABASE_URL=https://scryfkefedzuetfdtrvl.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Platform API keys (real values for local dev; not needed in CI — tests use fake adapters)
RAPIDAPI_KEY=<your-rapidapi-key>
YOUTUBE_API_KEY=<your-youtube-data-api-v3-key>
OPENROUTER_API_KEY=<your-openrouter-api-key>

# OpenRouter model (default used when env var absent)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Set to '1' to use fake fetch+LLM adapters end-to-end (Plan 4 E2E / fixture mode)
SCAN_FIXTURE_MODE=
